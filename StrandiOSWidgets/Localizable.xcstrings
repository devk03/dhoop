    "Upcoming events and invitations from your last Life sync. Tap to open Dhoop.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming events and invitations from your last Life sync. Tap to open Dhoop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anstehende Termine und Einladungen aus der letzten Life-Synchronisierung. Tippen öffnet Dhoop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximos eventos e invitaciones de tu última sincronización con Life. Toca para abrir Dhoop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Événements et invitations de la dernière synchronisation Life. Touchez pour ouvrir Dhoop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventi e inviti dalla tua ultima sincronizzazione Life. Tocca per aprire Dhoop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadchodzące wydarzenia i zaproszenia z ostatniej synchronizacji Life. Stuknij, aby otworzyć Dhoop."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximos eventos e convites da última sincronização com o Life. Toque para abrir o Dhoop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предстоящие события и приглашения из последней синхронизации Life. Нажмите, чтобы открыть Dhoop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示上次 Life 同步的近期活动和邀请。轻点打开 Dhoop。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示上次 Life 同步的近期活動與邀請。點選開啟 Dhoop。"
          }
        }
      }
    }
