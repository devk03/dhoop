    "Place above Day Hub Summary for a dashboard-only Home Screen page.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Place above Day Hub Summary for a dashboard-only Home Screen page."}},"de":{"stringUnit":{"state":"translated","value":"Über der Tageszusammenfassung platzieren, für eine reine Übersichtsseite."}},"es":{"stringUnit":{"state":"translated","value":"Colócalo encima de Resumen del día para una página de inicio dedicada."}},"fr":{"stringUnit":{"state":"translated","value":"Placez-le au-dessus du résumé du jour pour une page d’accueil dédiée."}},"it":{"stringUnit":{"state":"translated","value":"Posizionalo sopra il riepilogo per una pagina Home dedicata."}},"pl":{"stringUnit":{"state":"translated","value":"Umieść nad podsumowaniem dnia, aby utworzyć stronę główną z samym panelem."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Coloque acima do resumo do dia para uma página de início dedicada."}},"ru":{"stringUnit":{"state":"translated","value":"Разместите над сводкой дня на отдельной странице домашнего экрана."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"置于每日概览摘要上方，组成专用主屏幕页面。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"置於每日概覽摘要上方，組成專用主畫面頁面。"}}}},
    "Place below Day Hub Calendar for food, workout status and sleep.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Place below Day Hub Calendar for food, workout status and sleep."}},"de":{"stringUnit":{"state":"translated","value":"Unter dem Tageskalender platzieren, für Ernährung, Trainingsstatus und Schlaf."}},"es":{"stringUnit":{"state":"translated","value":"Colócalo debajo del calendario del día para ver comida, entrenamiento y sueño."}},"fr":{"stringUnit":{"state":"translated","value":"Placez-le sous le calendrier du jour pour voir alimentation, entraînement et sommeil."}},"it":{"stringUnit":{"state":"translated","value":"Posizionalo sotto il calendario per cibo, allenamento e sonno."}},"pl":{"stringUnit":{"state":"translated","value":"Umieść pod kalendarzem dnia, aby wyświetlić jedzenie, stan treningu i sen."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Coloque abaixo do calendário do dia para alimentação, treino e sono."}},"ru":{"stringUnit":{"state":"translated","value":"Разместите под календарём дня для питания, статуса тренировки и сна."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"置于每日概览日历下方，查看饮食、训练状态和睡眠。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"置於每日概覽行事曆下方，查看飲食、訓練狀態和睡眠。"}}}},
